{
  "name": "pitayas-media",
  "version": "0.1.0-beta",
  "description": "Pitayas Media - pobieranie filmów i muzyki, także na telefon",
  "author": "Pitayas <inbox@rakunek.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -wl"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "torrent-stream": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pitayas.media",
    "productName": "Pitayas-Media",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "executableName": "pitayas-media",
      "category": "AudioVideo",
      "icon": "build/icons",
      "maintainer": "Pitayas <inbox@rakunek.com>"
    },
    "rpm": {
      "packageName": "pitayas-media",
      "fpm": [
        "--rpm-compression",
        "none"
      ],
      "artifactName": "pitayas-media-${version}.${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "artifactName": "PitayasMedia-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "appImage": {
      "artifactName": "PitayasMedia-${version}-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 Pitayas"
  },
  "homepage": "https://github.com/Pitayas-Team/Pitayas-Media",
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron@32.3.3": true
  }
}
